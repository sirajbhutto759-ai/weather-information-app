# =============================================================================
# .gitignore — Weather Information Application
# =============================================================================

# ── Secrets & credentials ────────────────────────────────────────────────────
.env
.env.*
*.env
secrets.py
credentials.py
*.key
*.pem
*.p12

# ── Python cache & compiled files ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
virtualenv/

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Runtime & generated files ─────────────────────────────────────────────────
*.log
weather_app.log
improved/weather_app.log

# ── Local SQLite database (runtime data) ──────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── IDE & editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
